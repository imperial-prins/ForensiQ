# CodeFlux server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite and local evidence retention
SQLITE_DB_PATH=data/threat_intelligence.db
EVIDENCE_DIR=evidence
RETENTION_DAYS=30

# Gmail provider: mock is safe for demos; live requires server-side OAuth credentials.
GMAIL_ENABLED=true
# Use mock for deterministic local demo, or live for Google OAuth.
GMAIL_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URI in Google Cloud for a Web application OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
# Frontend destination after OAuth callback.
FRONTEND_URL=http://localhost:3000
GMAIL_OAUTH_STATE_SECRET=

# AI provider. Leave the placeholder to use the deterministic fallback.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Passive intelligence providers. Offline/mock mode never fetches URLs from emails.
IP_GEO_API_URL=https://ip-api.com/json/
INTEL_MODE=mock
GEOIP_MODE=mock
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
